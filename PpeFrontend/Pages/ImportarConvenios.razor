@page "/importar-convenios"
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]

@code {
    private HttpClient Http => ClientFactory.CreateClient("Autenticado");
}
<PageTitle>PPE - Importar Convênios</PageTitle>
<h3>Importar Convênios</h3>

<InputFile OnChange="HandleFileUpload" multiple />
@if (mensagem != null)
{
    <p>@mensagem</p>
}

@code {
    string? mensagem;


    async Task HandleFileUpload(InputFileChangeEventArgs e)
    {

        foreach (var file in e.GetMultipleFiles())
        {
            var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "arquivo", file.Name);

            var response = await Http.PostAsync("api/Convenios/importar-inicial", content);


            mensagem = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
            {
                mensagem = "";
                var texto = await response.Content.ReadAsStringAsync();
                mensagem = $"✅ Importação concluída: {texto}";
            }
            else
            {
                mensagem = "";
                var erro = await response.Content.ReadAsStringAsync();
                mensagem = $"❌ Erro ({response.StatusCode}): {erro}";
            }


        }

    }
}