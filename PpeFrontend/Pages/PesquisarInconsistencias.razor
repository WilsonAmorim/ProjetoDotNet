@page "/inconsistencias"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "usuario,gestor")]
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider


@using PpeFrontend.DTOs
@using PpeFrontend.Models
@inject HttpClient Http
@inject IJSRuntime JS

@inject IHttpClientFactory ClientFactory


@inject IJSRuntime JS

<PageTitle>PPE -Inconsistências</PageTitle>
<h3>🔍 Pesquisa de Inconsistências</h3>

<div class="card p-3 mb-4">
    <div class="row g-3">
        <label>Convênio</label>
        <select class="form-select" @bind="convenioSelecionado">
            @foreach (var c in convenios)
            {
                <option value="@c">@c</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary me-2" @onclick="Pesquisar">Pesquisar</button>
        <button class="btn btn-secondary" @onclick="Limpar">Limpar</button>
    </div>
</div>
<div class="col-md-2 d-flex align-items-end">
    <button class="btn btn-secondary me-2" @onclick="ImprimirPdf">Imprimir PDF</button>
    <button class="btn btn-secondary me-2" @onclick="ImprimirExcel">Imprimir EXCEL</button>
</div>


@if (resultados.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ações</th>

                <th>Id</th>
                <th>Data Conferência</th>
                <th>CPF</th>
                <th>Matricula</th>
                <th>Nome</th>
                <th>Data Admissão</th>
                <th>Data Demissão</th>
                <th>Documento</th>
                <th>Ocorrência</th>
                <th>Descrição</th>
                <th>Link Ocorrência</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ConferenciaRealizadaDTO conferenciaRealizada in resultados)
            {
                <tr>
                    <td>
                        <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => AbrirModal(conferenciaRealizada)"><i
                                class="bi bi-trash"></i></button>
                    </td>
                    <td>@conferenciaRealizada.Id</td>
                    <td>@conferenciaRealizada.DataAtualizacao.ToString("dd/MM/yyyy")</td>
                    <td>@conferenciaRealizada.Cpf</td>
                    <td>@conferenciaRealizada.Matricula</td>
                    <td>@conferenciaRealizada.Nome</td>
                    <td>@conferenciaRealizada.DataAdmissao.ToString("dd/MM/yyyy")</td>
                    <td>@conferenciaRealizada.DataDemissao?.ToString("dd/MM/yyyy")</td>
                    <td>@conferenciaRealizada.Documento</td>
                    <td>@conferenciaRealizada.Ocorrencia</td>
                    <td>@conferenciaRealizada.Descricao</td>
                    <td>@conferenciaRealizada.LinkOcorrencia</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (pesquisado)
{
    <p class="text-muted">Nenhum resultado encontrado.</p>
}

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Tarefa</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <label>Status:</label>
                    <InputSelect class="form-select mb-3" @bind-Value="novoStatus">
                        @foreach (var status in statusDisponiveis)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>



                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                        <button class="btn btn-primary" @onclick="SalvarEdicao">Salvar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var usuario = user.Identity.Name; // Nome do usuário logado
                                              // Se precisar de claims específicas:
            var role = user.FindFirst(c => c.Type == "role")?.Value;
            var email = user.FindFirst(c => c.Type == "email")?.Value;
        }
    }
    int mes = DateTime.Now.Month;
    int ano = DateTime.Now.Year;
    string convenioSelecionado = "";
    string novoStatus = "";
    bool pesquisado = false;

    bool mostrarModal = false;

    List<string> statusDisponiveis = new() { "Registrado", "Cancelado", "Enviado" };
    ConferenciaDTO conferenciaSelecionada = new();
    @* protected override async Task OnInitializedAsync()
    {

    } *@

    List<string> convenios = new() { "Fesfsus Lote 01", "Flem Lote 02", "Flem Lote 03" };
    List<ConferenciaRealizadaDTO> resultados = new();

    List<ConferenciaRealizadaDTO> conferenciaRealizada = new();

    async Task Pesquisar()
    {
        pesquisado = true;

        var query = new ConferenciaFiltroDTO
        {
            ConvenioNome = convenioSelecionado
        };

        var http = ClientFactory.CreateClient("Autenticado");


        var response = await http.PostAsJsonAsync("api/Conferencias/pesquisar-conferencia", query);

        Console.WriteLine($"🔽 Enviado: {query.ConvenioNome}");

        if (response.IsSuccessStatusCode)
        {
            resultados = await response.Content.ReadFromJsonAsync<List<ConferenciaRealizadaDTO>>() ?? new();
        }


    }

    private async Task ImprimirPdf()
    {
        var query = new ConferenciaFiltroDTO
        {
            ConvenioNome = convenioSelecionado
        };

        var http = ClientFactory.CreateClient("Autenticado");

        var response = await http.PostAsJsonAsync("api/Conferencias/relatorio-conferencia", query);
        Console.WriteLine($"🔽 Enviado: {query.ConvenioNome}");

        if (response.IsSuccessStatusCode)
        {
            var pdfBytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("downloadFile", "relatorio_conferencia.pdf", "application/pdf", pdfBytes);
        }
        else
        {
            Console.WriteLine("Erro ao gerar PDF");
        }
    }

    private async Task ImprimirExcel()
    {
        var query = new ConferenciaFiltroDTO
        {
            ConvenioNome = convenioSelecionado
        };

        var http = ClientFactory.CreateClient("Autenticado");

        // Endpoint: api/Conferencias/relatorio-excel (OK)
        var response = await http.PostAsJsonAsync("api/Conferencias/relatorio-excel", query);
        Console.WriteLine($"🔽 Enviado: {query.ConvenioNome}");

        if (response.IsSuccessStatusCode)
        {
            // ⚠️ CORREÇÃO: Variável deve ser 'excelBytes' e não 'pdfBytes'
            var excelBytes = await response.Content.ReadAsByteArrayAsync();

            // ⚠️ CORREÇÃO DE NOME E MIME TYPE
            await JS.InvokeVoidAsync(
            "downloadFile",
            "relatorio_conferencia.xlsx", // MUDANÇA 1: Extensão para XLSX
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", // MUDANÇA 2: MIME Type correto para XLSX
            excelBytes
            );
        }
        else
        {
            // ⚠️ Lembre-se de ajustar a mensagem de erro
            Console.WriteLine("Erro ao gerar relatório Excel");
        }
    }

    private async Task SalvarEdicao()
    {
        if (conferenciaSelecionada == null) return;

        var query = new EditarConferenciaDTO
        {
            Status = novoStatus,
        };
        try
        {
            var http = ClientFactory.CreateClient("Autenticado");
            var response = await http.PostAsJsonAsync("api/Convenios/editar/{conferenciaSelecionada.Id}", query);
            if (response.IsSuccessStatusCode)
            {

                FecharModal();
            }
            else
            {
                Console.WriteLine("Erro ao salvar edição: " + response.ReasonPhrase);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro na requisição de edição: " + ex.Message);
        }
    }

    void Limpar()
    {

        convenioSelecionado = "";
        resultados.Clear();
        pesquisado = false;
    }


    private void AbrirModal(ConferenciaRealizadaDTO conferencia)
    {

        mostrarModal = true;
    }

    private void FecharModal()
    {
        mostrarModal = false;

    }


}