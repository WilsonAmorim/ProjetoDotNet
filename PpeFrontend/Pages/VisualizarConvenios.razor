@page "/visualizar-convenios"
@inject HttpClient Http
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Net.Http
@using System.Net.Http.Headers

<h3>Convênios Importados</h3>

<div class="mb-3">
    <input class="form-control" placeholder="Filtrar por convenio..." @bind="filtroConvenioNome" />
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Convênio</th>
            <th>CPF</th>
            <th>Matricula</th>
            <th>Nome</th>
            <th>Data Admissao</th>
            <th>Data Demissao</th>
            <th>Situacao</th>
            <th>Categoria</th>
            <th>Funcao</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in conveniosFiltrados)
        {
            <tr>
                <td>@c.ConvenioNome</td>
                <td>@c.Cpf</td>
                <td>@c.Matricula</td>
                <td>@c.Nome</td>
                <td>@c.DataAdmissao</td>
                <td>@c.DataDemissao</td>
                <td>@c.Situacao</td>
                <td>@c.Categoria</td>
                <td>@c.Funcao</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ConvenioDto> convenios = new();
    private string filtroConvenioNome = "";

    private IEnumerable<ConvenioDto> conveniosFiltrados =>
    string.IsNullOrWhiteSpace(filtroConvenioNome)
    ? convenios
    : convenios.Where(c => c.ConvenioNome?.Contains(filtroConvenioNome, StringComparison.OrdinalIgnoreCase) == true);

    protected override async Task OnInitializedAsync()
    {
        convenios = await Http.GetFromJsonAsync<List<ConvenioDto>>("api/Convenios") ?? new List<ConvenioDto>();
    }
    public class ConvenioDto
    {
        public string? ConvenioNome { get; set; }
        public string? Cpf { get; set; }
        public string? Matricula { get; set; }
        public string? Nome { get; set; }
        public DateTime? DataAdmissao { get; set; }
        public DateTime? DataDemissao { get; set; }
        public string? Situacao { get; set; }
        public string? Categoria { get; set; }
        public string? Funcao { get; set; }
    }
}